PORT=5001
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/econ-lms

JWT_ACCESS_SECRET=<openssl rand -hex 64>
JWT_REFRESH_SECRET=<openssl rand -hex 64>

# Comma-separated list of allowed origins. In production, set to your Vercel frontend URL(s)
# e.g. https://ewt.vercel.app,https://econwiththusitha.com
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_NOTIFY_URL=https://YOUR-API-DOMAIN/api/payments/payhere/notify
PAYHERE_RETURN_URL=https://YOUR-FRONTEND-DOMAIN/payments
PAYHERE_CANCEL_URL=https://YOUR-FRONTEND-DOMAIN/payments

# Cloudinary (REQUIRED — used for all file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
