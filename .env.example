PORT=5001
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/econ-lms

JWT_ACCESS_SECRET=<openssl rand -hex 64>
JWT_REFRESH_SECRET=<openssl rand -hex 64>

# Production allowlist (comma-separated). For local dev, set to http://localhost:5173
CLIENT_URL=https://www.econwiththusitha.com,https://econwiththusitha.com

NODE_ENV=development

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_NOTIFY_URL=https://api.econwiththusitha.com/api/payments/payhere/notify
PAYHERE_RETURN_URL=https://www.econwiththusitha.com/payments
PAYHERE_CANCEL_URL=https://www.econwiththusitha.com/payments

# Cloudinary (REQUIRED — used for all file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
